@PACKAGE_INIT@

if(POLICY CMP0167)
	cmake_policy(SET CMP0167 NEW)
endif()

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(Eigen3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/inekfTargets.cmake")

# Backward-compatible variables for older consumers.
set(inekf_LIBRARIES inekf::inekf)
if(TARGET inekf::inekf)
	get_target_property(inekf_INCLUDE_DIRS inekf::inekf INTERFACE_INCLUDE_DIRECTORIES)
endif()

check_required_components(inekf)